#!/usr/bin/env sh

# Husky runs hooks in a stripped environment that doesn't inherit your
# shell profile (.zshrc / .bash_profile), so user-local Node/pnpm install
# paths aren't on PATH by default. Prepend the common locations so
# `pnpm` resolves whether it was installed via the standalone installer
# (~/.local/bin), Homebrew (/opt/homebrew/bin on Apple Silicon,
# /usr/local/bin on Intel), or corepack.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

pnpm lint && pnpm lint:fix && pnpm format || exit 1

# Pixel Police — block the push on NEW token/component violations in the
# commits being pushed (added lines only, vs. the merge-base with origin/main).
# Escape hatch for a genuine emergency: PIXEL_POLICE_SKIP=1 git push
if [ "${PIXEL_POLICE_SKIP:-0}" = "1" ]; then
  echo "Pixel Police: skipped (PIXEL_POLICE_SKIP=1)"
else
  git fetch --quiet --no-tags origin main 2>/dev/null || true
  bash scripts/pixel-police.sh || exit 1
fi
